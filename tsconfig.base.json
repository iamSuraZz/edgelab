{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    /**
     * nodenext picks CommonJS or ESM per file from the nearest package.json "type".
     * None of our packages set "type": "module", so they emit CommonJS — which both
     * the NestJS API and the Vite web app can consume. apps/web overrides this with
     * bundler resolution.
     */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",

    /* Strictness — every package inherits this. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "useUnknownInCatchVariables": true,

    /* Interop + emit */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "pretty": true
  },
  "exclude": ["node_modules", "dist"]
}
