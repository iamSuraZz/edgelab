# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Every value here is read through packages/shared's zod-validated config schema;
# nothing reads process.env directly outside of that module.

# PostgreSQL + TimescaleDB (matches docker-compose.yml credentials)
DATABASE_URL=postgresql://edgelab:edgelab@localhost:5432/edgelab

# Redis 7 — BullMQ queues and API/worker coordination
REDIS_URL=redis://localhost:6379

# Market data provider. Server-side only — never sent to the browser.
TWELVEDATA_API_KEY=

# Account denomination used for currency conversion of P&L
ACCOUNT_CURRENCY=USD

# Ports
API_PORT=3001
WEB_PORT=5173

# Where downloaded/imported M1 bars are cached on disk
DATA_CACHE_DIR=./.cache
