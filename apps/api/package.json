{
  "name": "@edgelab/api",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@edgelab/data": "workspace:*",
    "@edgelab/db": "workspace:*",
    "@edgelab/engine": "workspace:*",
    "@edgelab/metrics": "workspace:*",
    "@edgelab/shared": "workspace:*",
    "@edgelab/validation": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "bullmq": "6.3.9",
    "ioredis": "6.0.0",
    "lru-cache": "11.5.3",
    "multer": "2.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@edgelab/worker": "workspace:*",
    "@types/express": "5.0.5",
    "@types/multer": "2.2.0",
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
